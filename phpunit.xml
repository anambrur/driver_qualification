<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <!-- Failing tests that prove an open bug. Run them with: composer test:known-issues -->
            <group>known-issue</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The full suite outgrew PHP's default 128M (each Laravel test leaks ~0.2 MB; Pest arch tests parse all of App) -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- .env holds live keys; force dummies so an unmocked call can never charge a card or send an SMS -->
        <env name="STRIPE_KEY" value="pk_test_dummy" force="true"/>
        <env name="STRIPE_SECRET" value="sk_test_dummy" force="true"/>
        <env name="STRIPE_WEBHOOK_SECRET" value="whsec_test_secret" force="true"/>
        <env name="VONAGE_API_KEY" value="test_key" force="true"/>
        <env name="VONAGE_API_SECRET" value="test_secret" force="true"/>
        <env name="VONAGE_SMS_FROM" value="15550000000" force="true"/>
        <env name="FILESYSTEM_DISK" value="local" force="true"/>
    </php>
</phpunit>

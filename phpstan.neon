includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Level 5 is the working level. ~90% of today's findings are "relation/property not found",
    # caused by relationship methods without return types (e.g. `public function company()`
    # instead of `public function company(): BelongsTo`). Adding return types removes that noise.
    level: 5
    paths:
        - app/
    tmpDir: storage/framework/cache/phpstan
    treatPhpDocTypesAsCertain: false
